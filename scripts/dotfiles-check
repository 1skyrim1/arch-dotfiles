#!/usr/bin/env bash
# Shows everything on this system that is not in ~/dotfiles (and the other way round)
D=~/arch-dotfiles
list() { sed 's/#.*//' "$@" | tr -d '\r' | tr -s ' \t' '\n' | sed '/^$/d' | sort -u; }

echo "== Installed, but not in packages/*.txt"
comm -13 <(list "$D"/packages/*.txt) <(pacman -Qqe | sort)

echo "== In packages/*.txt, but not installed"
comm -23 <(list "$D"/packages/*.txt) <(pacman -Qq | sort)

echo "== Changed in /etc, but not in system/"
LC_ALL=C pacman -Qii | grep -o '/[^ ]* \[modified\]' | cut -d' ' -f1 | while read -r f; do
  [ -e "$D/system$f" ] || echo "$f" | grep -v -x -E '/etc/(passwd|group|shadow|gshadow|subuid|subgid|shells|resolv\.conf|fstab|hostname|machine-id|adjtime)'
done

echo "== In system/, but different from /etc"
(cd "$D/system" && find . -type f) | while read -r f; do
  sudo cmp -s "$D/system/${f#./}" "/${f#./}" || echo "/${f#./}"
done

echo "== ~/.config folders not linked by stow"
for d in ~/.config/*; do
  [ -L "$d" ] && continue
  [ -d "$d" ] && [ -n "$(find "$d" -type l -lname '*dotfiles/*' -print -quit)" ] && continue
  basename "$d"
done | sort | grep -v -x -E 'dconf|gh|systemd|pulse|lazygit|user-dirs.dirs|user-dirs.locale|yay'

echo "== Uncommitted changes"
git -C "$D" status --short
