#!/usr/bin/env bash
# Search the AUR, install the selection and add it to packages/aur.txt
list=~/dotfiles/packages/aur.txt

pkgs=$(yay -Slqa | sort -u | fzf --multi \
  --preview 'yay -Siia {1}' --preview-window 'down:65%:wrap' \
  --preview-label 'tab: multi-select, alt-b: PKGBUILD, alt-i: info' \
  --bind 'alt-b:change-preview:yay -Gpa {1} | tail -n +5' \
  --bind 'alt-i:change-preview:yay -Siia {1}')
[ -z "$pkgs" ] && exit 0

yay -S --needed $pkgs

# Record every selected package that is really installed now (independent of the exit code)
for p in $pkgs; do
  pacman -Q "$p" &>/dev/null || { echo "Not installed: $p"; continue; }
  grep -qxF "$p" "$list" 2>/dev/null || { echo "$p" >> "$list"; echo "Added to $(basename "$list"): $p"; }
done
