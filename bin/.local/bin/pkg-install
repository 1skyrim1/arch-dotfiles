#!/usr/bin/env bash
# Search the official repos, install the selection and add it to packages/desktop.txt
list=~/arch-dotfiles/packages/desktop.txt

pkgs=$(pacman -Slq | sort -u | fzf --multi \
  --preview 'pacman -Sii {1}' --preview-window 'down:65%:wrap' \
  --preview-label 'tab: multi-select')
[ -z "$pkgs" ] && exit 0

sudo pacman -S --needed $pkgs

# Record every selected package that is really installed now (independent of the exit code)
for p in $pkgs; do
  pacman -Q "$p" &>/dev/null || { echo "Not installed: $p"; continue; }
  grep -qxF "$p" "$list" 2>/dev/null || { echo "$p" >> "$list"; echo "Added to $(basename "$list"): $p"; }
done
